{
  "mcpServers": {
    "sap-cpi-guardian": {
      "type": "stdio",
      "command": "node",
      "args": ["dist/mcpServer.js"]
    }
  },
  "permissions": {
    "deny": [
      "Write(.env)",
      "Edit(.env)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)"
    ],
    "allow": [
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(node dist/mcpServer.js)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Write(src/**)",
      "Edit(src/**)",
      "Write(reports/**)",
      "Write(baselines/**)",
      "Write(CLAUDE.md)",
      "Write(.claude/agents/**)",
      "Write(.claude/commands/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/git-sync-check.sh",
            "statusMessage": "Checking git sync status..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-build.sh",
            "statusMessage": "Rebuilding dist/ after source change...",
            "async": true
          }
        ]
      }
    ]
  }
}
