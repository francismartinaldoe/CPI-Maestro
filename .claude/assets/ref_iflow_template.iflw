<?xml version="1.0" encoding="UTF-8"?><bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ifl="http:///com.sap.ifl.model/Ifl.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" name="Definitions 1" targetNamespace="http://com.sap.it.ifl.tooling/default/flow">
    <bpmn2:collaboration id="Collaboration_1" name="Default Collaboration">
        <bpmn2:documentation id="Documentation_1" textFormat="text/plain"/>
        <bpmn2:extensionElements>
            <ifl:property><key>cmdVariantUri</key><value>ctype::IFlowVariant/cname::IFlowConfiguration/version::1.2.4</value></ifl:property>
            <ifl:property><key>returnExceptionToSender</key><value>false</value></ifl:property>
            <ifl:property><key>log</key><value>All events</value></ifl:property>
            <ifl:property><key>corsEnabled</key><value>false</value></ifl:property>
            <ifl:property><key>componentVersion</key><value>1.2</value></ifl:property>
            <ifl:property><key>allowedHeaderList</key><value>Content-Type</value></ifl:property>
            <ifl:property><key>ServerTrace</key><value>false</value></ifl:property>
            <ifl:property><key>accessControlAllowCredentials</key><value>false</value></ifl:property>
            <ifl:property><key>httpSessionHandling</key><value>None</value></ifl:property>
            <ifl:property><key>namespaceMapping</key><value/></ifl:property>
        </bpmn2:extensionElements>
        <bpmn2:participant id="Participant_Sender" ifl:type="EndpointSender" name="C4C">
            <bpmn2:extensionElements>
                <ifl:property><key>enableBasicAuthentication</key><value>false</value></ifl:property>
                <ifl:property><key>ifl:type</key><value>EndpointSender</value></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:participant>
        <bpmn2:participant id="Participant_Receiver_CPQ" ifl:type="EndpointRecevier" name="CPQ">
            <bpmn2:extensionElements>
                <ifl:property><key>ifl:type</key><value>EndpointRecevier</value></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:participant>
        <bpmn2:participant id="Participant_Process_1" ifl:type="IntegrationProcess" name="Integration Process" processRef="Process_1">
            <bpmn2:extensionElements/>
        </bpmn2:participant>
        <bpmn2:messageFlow id="MF_Sender_Start" name="HTTPS" sourceRef="Participant_Sender" targetRef="StartEvent_1">
            <bpmn2:extensionElements>
                <ifl:property><key>ComponentType</key><value>HTTPS</value></ifl:property>
                <ifl:property><key>ComponentNS</key><value>sap</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.5</value></ifl:property>
                <ifl:property><key>urlPath</key><value>{{Sender_Address}}</value></ifl:property>
                <ifl:property><key>Name</key><value>HTTPS</value></ifl:property>
                <ifl:property><key>TransportProtocolVersion</key><value>1.5.0</value></ifl:property>
                <ifl:property><key>ComponentSWCVName</key><value>external</value></ifl:property>
                <ifl:property><key>system</key><value>C4C</value></ifl:property>
                <ifl:property><key>xsrfProtection</key><value>0</value></ifl:property>
                <ifl:property><key>TransportProtocol</key><value>HTTPS</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::AdapterVariant/cname::sap:HTTPS/tp::HTTPS/mp::None/direction::Sender/version::1.5.0</value></ifl:property>
                <ifl:property><key>userRole</key><value>ESBMessaging.send</value></ifl:property>
                <ifl:property><key>senderAuthType</key><value>None</value></ifl:property>
                <ifl:property><key>MessageProtocol</key><value>None</value></ifl:property>
                <ifl:property><key>MessageProtocolVersion</key><value>1.5.0</value></ifl:property>
                <ifl:property><key>ComponentSWCVId</key><value>1.5.0</value></ifl:property>
                <ifl:property><key>direction</key><value>Sender</value></ifl:property>
                <ifl:property><key>clientCertificates</key><value/></ifl:property>
                <ifl:property><key>maximumBodySize</key><value>40</value></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:messageFlow>
        <bpmn2:messageFlow id="MF_CheckQuote" name="HTTP" sourceRef="ServiceTask_CheckQuote" targetRef="Participant_Receiver_CPQ">
            <bpmn2:extensionElements>
                <ifl:property><key>ComponentType</key><value>HTTP</value></ifl:property>
                <ifl:property><key>ComponentNS</key><value>sap</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.15</value></ifl:property>
                <ifl:property><key>httpMethod</key><value>GET</value></ifl:property>
                <ifl:property><key>Name</key><value>HTTP_CheckQuote</value></ifl:property>
                <ifl:property><key>TransportProtocolVersion</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>ComponentSWCVName</key><value>external</value></ifl:property>
                <ifl:property><key>httpAddressWithoutQuery</key><value>https://{{CPQ_Host}}/api/v1/quotes</value></ifl:property>
                <ifl:property><key>httpAddressQuery</key><value/></ifl:property>
                <ifl:property><key>httpRequestTimeout</key><value>{{Timeout}}</value></ifl:property>
                <ifl:property><key>MessageProtocol</key><value>None</value></ifl:property>
                <ifl:property><key>ComponentSWCVId</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>allowedResponseHeaders</key><value>*</value></ifl:property>
                <ifl:property><key>allowedRequestHeaders</key><value>Authorization|Content-Type|CamelHttpQuery</value></ifl:property>
                <ifl:property><key>direction</key><value>Receiver</value></ifl:property>
                <ifl:property><key>httpShouldSendBody</key><value>false</value></ifl:property>
                <ifl:property><key>throwExceptionOnFailure</key><value>false</value></ifl:property>
                <ifl:property><key>proxyType</key><value>default</value></ifl:property>
                <ifl:property><key>system</key><value>CPQ</value></ifl:property>
                <ifl:property><key>authenticationMethod</key><value>{{CPQ_Authentication}}</value></ifl:property>
                <ifl:property><key>credentialName</key><value>{{CPQ_Credential}}</value></ifl:property>
                <ifl:property><key>retryIteration</key><value>1</value></ifl:property>
                <ifl:property><key>retryOnConnectionFailure</key><value>false</value></ifl:property>
                <ifl:property><key>retryInterval</key><value>5</value></ifl:property>
                <ifl:property><key>TransportProtocol</key><value>HTTP</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::AdapterVariant/cname::sap:HTTP/tp::HTTP/mp::None/direction::Receiver/version::1.15.0</value></ifl:property>
                <ifl:property><key>MessageProtocolVersion</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>enableMPLAttachments</key><value>true</value></ifl:property>
                <ifl:property><key>Description</key><value/></ifl:property>
                <ifl:property><key>privateKeyAlias</key><value/></ifl:property>
                <ifl:property><key>proxyHost</key><value/></ifl:property>
                <ifl:property><key>proxyPort</key><value/></ifl:property>
                <ifl:property><key>locationID</key><value/></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:messageFlow>
        <bpmn2:messageFlow id="MF_CreateQuote" name="HTTP" sourceRef="ServiceTask_CreateQuote" targetRef="Participant_Receiver_CPQ">
            <bpmn2:extensionElements>
                <ifl:property><key>ComponentType</key><value>HTTP</value></ifl:property>
                <ifl:property><key>ComponentNS</key><value>sap</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.15</value></ifl:property>
                <ifl:property><key>httpMethod</key><value>POST</value></ifl:property>
                <ifl:property><key>Name</key><value>HTTP_CreateQuote</value></ifl:property>
                <ifl:property><key>TransportProtocolVersion</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>ComponentSWCVName</key><value>external</value></ifl:property>
                <ifl:property><key>httpAddressWithoutQuery</key><value>https://{{CPQ_Host}}/api/v1/quotes</value></ifl:property>
                <ifl:property><key>httpAddressQuery</key><value/></ifl:property>
                <ifl:property><key>httpRequestTimeout</key><value>{{Timeout}}</value></ifl:property>
                <ifl:property><key>MessageProtocol</key><value>None</value></ifl:property>
                <ifl:property><key>ComponentSWCVId</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>allowedResponseHeaders</key><value>*</value></ifl:property>
                <ifl:property><key>allowedRequestHeaders</key><value>Authorization|Content-Type|Accept</value></ifl:property>
                <ifl:property><key>direction</key><value>Receiver</value></ifl:property>
                <ifl:property><key>httpShouldSendBody</key><value>false</value></ifl:property>
                <ifl:property><key>throwExceptionOnFailure</key><value>true</value></ifl:property>
                <ifl:property><key>proxyType</key><value>default</value></ifl:property>
                <ifl:property><key>system</key><value>CPQ</value></ifl:property>
                <ifl:property><key>authenticationMethod</key><value>{{CPQ_Authentication}}</value></ifl:property>
                <ifl:property><key>credentialName</key><value>{{CPQ_Credential}}</value></ifl:property>
                <ifl:property><key>retryIteration</key><value>1</value></ifl:property>
                <ifl:property><key>retryOnConnectionFailure</key><value>false</value></ifl:property>
                <ifl:property><key>retryInterval</key><value>5</value></ifl:property>
                <ifl:property><key>TransportProtocol</key><value>HTTP</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::AdapterVariant/cname::sap:HTTP/tp::HTTP/mp::None/direction::Receiver/version::1.15.0</value></ifl:property>
                <ifl:property><key>MessageProtocolVersion</key><value>1.15.0</value></ifl:property>
                <ifl:property><key>enableMPLAttachments</key><value>true</value></ifl:property>
                <ifl:property><key>Description</key><value/></ifl:property>
                <ifl:property><key>privateKeyAlias</key><value/></ifl:property>
                <ifl:property><key>proxyHost</key><value/></ifl:property>
                <ifl:property><key>proxyPort</key><value/></ifl:property>
                <ifl:property><key>locationID</key><value/></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:messageFlow>
    </bpmn2:collaboration>
    <bpmn2:process id="Process_1" name="Integration Process">
        <bpmn2:extensionElements>
            <ifl:property><key>cmdVariantUri</key><value>ctype::FlowElementVariant/cname::IntegrationProcess/version::1.2.1</value></ifl:property>
            <ifl:property><key>transactionTimeout</key><value>30</value></ifl:property>
            <ifl:property><key>componentVersion</key><value>1.2</value></ifl:property>
            <ifl:property><key>transactionalHandling</key><value>Not Required</value></ifl:property>
        </bpmn2:extensionElements>
        <!-- Exception Subprocess -->
        <bpmn2:subProcess id="SubProcess_Exception" name="Exception Subprocess">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>activityType</key><value>ErrorEventSubProcessTemplate</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ErrorEventSubProcessTemplate/version::1.1.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:startEvent id="SubStart_Error" name="Error Start">
                <bpmn2:outgoing>SubSF_1</bpmn2:outgoing>
                <bpmn2:errorEventDefinition>
                    <bpmn2:extensionElements>
                        <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ErrorStartEvent</value></ifl:property>
                        <ifl:property><key>activityType</key><value>StartErrorEvent</value></ifl:property>
                    </bpmn2:extensionElements>
                </bpmn2:errorEventDefinition>
            </bpmn2:startEvent>
            <bpmn2:callActivity id="Script_ErrorHandler" name="CNS_CPQ_ErrorHandler">
                <bpmn2:extensionElements>
                    <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
                    <ifl:property><key>scriptBundleId</key><value/></ifl:property>
                    <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                    <ifl:property><key>activityType</key><value>Script</value></ifl:property>
                    <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GroovyScript/version::1.1.2</value></ifl:property>
                    <ifl:property><key>subActivityType</key><value>GroovyScript</value></ifl:property>
                    <ifl:property><key>script</key><value>CNS_CPQ_ErrorHandler.groovy</value></ifl:property>
                </bpmn2:extensionElements>
                <bpmn2:incoming>SubSF_1</bpmn2:incoming>
                <bpmn2:outgoing>SubSF_2</bpmn2:outgoing>
            </bpmn2:callActivity>
            <bpmn2:endEvent id="SubEnd_Error" name="End Error">
                <bpmn2:extensionElements>
                    <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                    <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageEndEvent/version::1.1.0</value></ifl:property>
                </bpmn2:extensionElements>
                <bpmn2:incoming>SubSF_2</bpmn2:incoming>
                <bpmn2:messageEventDefinition/>
            </bpmn2:endEvent>
            <bpmn2:sequenceFlow id="SubSF_1" sourceRef="SubStart_Error" targetRef="Script_ErrorHandler"/>
            <bpmn2:sequenceFlow id="SubSF_2" sourceRef="Script_ErrorHandler" targetRef="SubEnd_Error"/>
        </bpmn2:subProcess>
        <!-- Main flow -->
        <bpmn2:startEvent id="StartEvent_1" name="Start">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageStartEvent/version::1.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:outgoing>SF_1</bpmn2:outgoing>
            <bpmn2:messageEventDefinition/>
        </bpmn2:startEvent>
        <!-- Step 1: Initial Content Modifier -->
        <bpmn2:callActivity id="ContentModifier_InitHeaders" name="Set Standard Headers">
            <bpmn2:extensionElements>
                <ifl:property><key>bodyType</key><value>constant</value></ifl:property>
                <ifl:property><key>propertyTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;${in.body}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;c4cSourcePayload&lt;/cell&gt;&lt;cell id='Datatype'&gt;java.lang.String&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
                <ifl:property><key>headerTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;C4C&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Sender&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;CPQ&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Receiver&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;CNS_C4C_CPQ_QuoteCreate&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;ApplicationID&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;application/json&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Content-Type&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
                <ifl:property><key>wrapContent</key><value/></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.6</value></ifl:property>
                <ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::Enricher/version::1.6.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_1</bpmn2:incoming>
            <bpmn2:outgoing>SF_2</bpmn2:outgoing>
        </bpmn2:callActivity>
        <!-- Step 2: Groovy - Set CPQ Custom Headers -->
        <bpmn2:callActivity id="Script_SetCPQHeaders" name="CNS_CPQ_SetCustomHeaders">
            <bpmn2:extensionElements>
                <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
                <ifl:property><key>scriptBundleId</key><value/></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>activityType</key><value>Script</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GroovyScript/version::1.1.2</value></ifl:property>
                <ifl:property><key>subActivityType</key><value>GroovyScript</value></ifl:property>
                <ifl:property><key>script</key><value>CNS_CPQ_SetCustomHeaders.groovy</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_2</bpmn2:incoming>
            <bpmn2:outgoing>SF_3</bpmn2:outgoing>
        </bpmn2:callActivity>
        <!-- Step 3: Request-Reply - Check Quote in CPQ -->
        <bpmn2:serviceTask id="ServiceTask_CheckQuote" name="Check CPQ Quote">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
                <ifl:property><key>activityType</key><value>ExternalCall</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ExternalCall/version::1.0.4</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_3</bpmn2:incoming>
            <bpmn2:outgoing>SF_4</bpmn2:outgoing>
        </bpmn2:serviceTask>
        <!-- Parse check response and determine quoteExists -->
        <bpmn2:callActivity id="Script_ParseCheckResponse" name="CNS_CPQ_ParseCheckResponse">
            <bpmn2:extensionElements>
                <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
                <ifl:property><key>scriptBundleId</key><value/></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>activityType</key><value>Script</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GroovyScript/version::1.1.2</value></ifl:property>
                <ifl:property><key>subActivityType</key><value>GroovyScript</value></ifl:property>
                <ifl:property><key>script</key><value>CNS_CPQ_ParseCheckResponse.groovy</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_4</bpmn2:incoming>
            <bpmn2:outgoing>SF_5</bpmn2:outgoing>
        </bpmn2:callActivity>
        <!-- Step 4: Router -->
        <bpmn2:exclusiveGateway default="SF_NO" id="ExclusiveGateway_QuoteExists" name="Quote Exists?">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>activityType</key><value>ExclusiveGateway</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ExclusiveGateway/version::1.1.2</value></ifl:property>
                <ifl:property><key>throwException</key><value>false</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_5</bpmn2:incoming>
            <bpmn2:outgoing>SF_YES</bpmn2:outgoing>
            <bpmn2:outgoing>SF_NO</bpmn2:outgoing>
        </bpmn2:exclusiveGateway>
        <!-- YES branch: quote already exists -->
        <bpmn2:callActivity id="ContentModifier_AlreadyExists" name="Set Already Exists Response">
            <bpmn2:extensionElements>
                <ifl:property><key>bodyType</key><value>expression</value></ifl:property>
                <ifl:property><key>propertyTable</key><value/></ifl:property>
                <ifl:property><key>headerTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;application/json&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Content-Type&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;200&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;CamelHttpResponseCode&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
                <ifl:property><key>wrapContent</key><value>{"status":"SKIPPED","message":"Quote already exists in SAP CPQ."}</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.6</value></ifl:property>
                <ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::Enricher/version::1.6.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_YES</bpmn2:incoming>
            <bpmn2:outgoing>SF_YES_END</bpmn2:outgoing>
        </bpmn2:callActivity>
        <bpmn2:endEvent id="EndEvent_AlreadyExists" name="End (Skipped)">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageEndEvent/version::1.1.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_YES_END</bpmn2:incoming>
            <bpmn2:messageEventDefinition/>
        </bpmn2:endEvent>
        <!-- NO branch: Step 5 - Message Mapping -->
        <bpmn2:callActivity id="MessageMapping_C4CToCPQ" name="CNS_C4C_CPQ_QuoteCreateMapping">
            <bpmn2:extensionElements>
                <ifl:property><key>mappinguri</key><value>dir://mmap/src/main/resources/mapping/CNS_C4C_CPQ_QuoteCreateMapping.mmap</value></ifl:property>
                <ifl:property><key>mappingname</key><value>CNS_C4C_CPQ_QuoteCreateMapping</value></ifl:property>
                <ifl:property><key>mappingSourceValue</key><value/></ifl:property>
                <ifl:property><key>mappingType</key><value>MessageMapping</value></ifl:property>
                <ifl:property><key>mappingReference</key><value>static</value></ifl:property>
                <ifl:property><key>mappingpath</key><value>src/main/resources/mapping/CNS_C4C_CPQ_QuoteCreateMapping</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.3</value></ifl:property>
                <ifl:property><key>activityType</key><value>Mapping</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageMapping/version::1.3.1</value></ifl:property>
                <ifl:property><key>messageMappingBundleId</key><value/></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_NO</bpmn2:incoming>
            <bpmn2:outgoing>SF_8</bpmn2:outgoing>
        </bpmn2:callActivity>
        <!-- Step 6: Prepare CPQ Create Quote Request -->
        <bpmn2:callActivity id="ContentModifier_PrepareCreate" name="Prepare Create Request">
            <bpmn2:extensionElements>
                <ifl:property><key>bodyType</key><value>constant</value></ifl:property>
                <ifl:property><key>propertyTable</key><value/></ifl:property>
                <ifl:property><key>headerTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;application/json&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Content-Type&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;application/json&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Accept&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
                <ifl:property><key>wrapContent</key><value/></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.6</value></ifl:property>
                <ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::Enricher/version::1.6.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_8</bpmn2:incoming>
            <bpmn2:outgoing>SF_9</bpmn2:outgoing>
        </bpmn2:callActivity>
        <!-- Step 7: Create Quote in CPQ -->
        <bpmn2:serviceTask id="ServiceTask_CreateQuote" name="Create CPQ Quote">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
                <ifl:property><key>activityType</key><value>ExternalCall</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ExternalCall/version::1.0.4</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_9</bpmn2:incoming>
            <bpmn2:outgoing>SF_10</bpmn2:outgoing>
        </bpmn2:serviceTask>
        <bpmn2:endEvent id="EndEvent_Created" name="End (Created)">
            <bpmn2:extensionElements>
                <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageEndEvent/version::1.1.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SF_10</bpmn2:incoming>
            <bpmn2:messageEventDefinition/>
        </bpmn2:endEvent>
        <!-- Sequence Flows -->
        <bpmn2:sequenceFlow id="SF_1"  sourceRef="StartEvent_1"            targetRef="ContentModifier_InitHeaders"/>
        <bpmn2:sequenceFlow id="SF_2"  sourceRef="ContentModifier_InitHeaders" targetRef="Script_SetCPQHeaders"/>
        <bpmn2:sequenceFlow id="SF_3"  sourceRef="Script_SetCPQHeaders"    targetRef="ServiceTask_CheckQuote"/>
        <bpmn2:sequenceFlow id="SF_4"  sourceRef="ServiceTask_CheckQuote"  targetRef="Script_ParseCheckResponse"/>
        <bpmn2:sequenceFlow id="SF_5"  sourceRef="Script_ParseCheckResponse" targetRef="ExclusiveGateway_QuoteExists"/>
        <bpmn2:sequenceFlow id="SF_YES" name="Y" sourceRef="ExclusiveGateway_QuoteExists" targetRef="ContentModifier_AlreadyExists">
            <bpmn2:extensionElements>
                <ifl:property><key>expressionType</key><value>NonXML</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GatewayRoute/version::1.0.0</value></ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:conditionExpression id="FE_SF_YES" xsi:type="bpmn2:tFormalExpression">${property.quoteExists} = 'true'</bpmn2:conditionExpression>
        </bpmn2:sequenceFlow>
        <bpmn2:sequenceFlow id="SF_YES_END" sourceRef="ContentModifier_AlreadyExists" targetRef="EndEvent_AlreadyExists"/>
        <bpmn2:sequenceFlow id="SF_NO" name="N" sourceRef="ExclusiveGateway_QuoteExists" targetRef="MessageMapping_C4CToCPQ">
            <bpmn2:extensionElements>
                <ifl:property><key>expressionType</key><value>XML</value></ifl:property>
                <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
                <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GatewayRoute/version::1.0.0</value></ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:sequenceFlow>
        <bpmn2:sequenceFlow id="SF_8"  sourceRef="MessageMapping_C4CToCPQ"  targetRef="ContentModifier_PrepareCreate"/>
        <bpmn2:sequenceFlow id="SF_9"  sourceRef="ContentModifier_PrepareCreate" targetRef="ServiceTask_CreateQuote"/>
        <bpmn2:sequenceFlow id="SF_10" sourceRef="ServiceTask_CreateQuote"   targetRef="EndEvent_Created"/>
    </bpmn2:process>
