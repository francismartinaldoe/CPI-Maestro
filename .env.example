# Maestro Orchestrator – Environment Configuration
# Copy this file to .env and fill in values.

# ── Anthropic / Claude (required for intent routing) ────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://your-proxy/v1   # optional: proxy URL

# ── Gatekeeper-Goofy sub-agent ──────────────────────────────────────────
# Transport mode: "mcp" (stdio, local install) or "http" (remote server)
GATEKEEPER_TRANSPORT=mcp
# MCP mode: now points to the shared CPI MCP server built into Maestro
GATEKEEPER_MCP_PATH=C:/Users/<YOUR-USERNAME>/repos/CPIMAESTRO/dist/mcp/CPI_MCP/index.js
# HTTP mode: base URL of the Gatekeeper-Goofy HTTP server (if GATEKEEPER_TRANSPORT=http)
# GATEKEEPER_HTTP_URL=http://localhost:3002

# ── FlowLens AI sub-agent ────────────────────────────────────────────────
# Transport mode: "http" (Express server) — FlowLens is always HTTP
FLOWLENS_HTTP_URL=http://localhost:3001

# ── Shared CPI MCP Server (CPI_MCP) ─────────────────────────────────────────
# All agents in Maestro call this single MCP server. No agent has its own CPI client.
#
# Single-tenant (same creds for all environments):
CPI_TENANT_URL=https://<tenant>.it-cpi<n>.cfapps.<region>.hana.ondemand.com
CPI_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=
#
# Multi-tenant (per-environment overrides — takes precedence over the base vars above):
# CPI_TENANT_URL_DEV=https://...
# CPI_TOKEN_URL_DEV=https://...
# CPI_CLIENT_ID_DEV=
# CPI_CLIENT_SECRET_DEV=
#
# CPI_TENANT_URL_TEST=https://...
# CPI_TOKEN_URL_TEST=https://...
# CPI_CLIENT_ID_TEST=
# CPI_CLIENT_SECRET_TEST=
#
# CPI_TENANT_URL_PROD=https://...
# CPI_TOKEN_URL_PROD=https://...
# CPI_CLIENT_ID_PROD=
# CPI_CLIENT_SECRET_PROD=
#
# Basic Auth alternative (if OAuth2 not available):
# CPI_USERNAME=
# CPI_PASSWORD=
#
# Default environment when no environment is specified in a tool call:
CPI_DEFAULT_ENV=DEV

# ── Shared JIRA MCP Server (JIRA_MCP) ───────────────────────────────────────
# Used by BOTH Gatekeeper-Goofy and FlowLens AI agents.
# One shared process is spawned — not one per agent (McpClientPool handles this).
#
JIRA_MCP_PATH=C:/Users/<YOUR-USERNAME>/repos/CPIMAESTRO/dist/mcp/JIRA_MCP/index.js
JIRA_BASE_URL=https://jira.<YOUR-DOMAIN>
#
# Auth mode — choose ONE:
#   basic  (default) — API token or password
#   sso              — OAuth2 browser SSO flow; Maestro opens browser at startup
JIRA_AUTH_MODE=basic
#
# Basic auth (JIRA_AUTH_MODE=basic):
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_or_password
#
# SSO / OAuth2 (JIRA_AUTH_MODE=sso):
# JIRA_CLIENT_ID=your_oauth_client_id
# JIRA_CLIENT_SECRET=your_oauth_client_secret
# JIRA_OAUTH_SCOPE=read:jira-work write:jira-work offline_access
# JIRA_OAUTH_CALLBACK_PORT=4000
# Tokens below are written automatically by the SSO flow — do not set manually:
# JIRA_ACCESS_TOKEN=
# JIRA_REFRESH_TOKEN=
# JIRA_TOKEN_EXPIRES_AT=
#
JIRA_DEFAULT_PROJECT=SAP

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte hex key used to encrypt secrets in UI localStorage and HTTP transport.
# Auto-generated if not set (logged to console on first start).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MAESTRO_ENCRYPTION_KEY=

# ── Orchestrator behaviour ───────────────────────────────────────────────
# Maximum conversation turns to keep in context
MAESTRO_MAX_HISTORY=20
# Logging level: debug | info | warn | error
LOG_LEVEL=info
# Comma-separated CPI package names for entity extraction (no spaces around commas)
# CPI_KNOWN_PACKAGES=YOUR_PACKAGE_ID,YOUR_PACKAGE_ID_2,CNSDevelopment,SAPSalesCloudVersion2IntegrationwithSAPCPQ

# ── A2A HTTP Server ───────────────────────────────────────────────────────────
# Port for the A2A JSON-RPC HTTP server.
# Start with: npm run dev:server   (dev)  |  npm run start:server (production)
A2A_PORT=3000

# Public base URL injected into the Agent Card's "url" field at runtime.
# Set this to your deployed Cloud Foundry / BTP route in production so that
# external A2A clients can discover and call your agent from anywhere.
# Example: https://cpimaestro.cfapps.eu10.hana.ondemand.com
# A2A_BASE_URL=https://cpimaestro.cfapps.eu10.hana.ondemand.com

# Optional bearer token for the A2A endpoint. If set, all POST / requests must
# include the header:  Authorization: Bearer <this value>
# The /.well-known/agent.json and /health endpoints are always public.
# A2A_API_KEY=your-secret-key-here
