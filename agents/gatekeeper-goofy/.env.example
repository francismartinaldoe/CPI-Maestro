# SAP CPI Connection — per-environment credentials
# Per-env vars (_TEST / _PRE_PROD / _PROD) take precedence over the base vars.
# Leave per-env vars blank to fall back to the base vars (single-tenant setup).

# ── TEST environment ─────────────────────────────────────────────────────────
CPI_TENANT_URL_TEST=https://<test-tenant>.it-cpi<n>.cfapps.<region>.hana.ondemand.com
CPI_TOKEN_URL_TEST=https://<test-subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
CPI_CLIENT_ID_TEST=<test-client-id>
CPI_CLIENT_SECRET_TEST=<test-client-secret>

# ── PRE-PROD environment ─────────────────────────────────────────────────────
CPI_TENANT_URL_PRE_PROD=https://<preprod-tenant>.it-cpi<n>.cfapps.<region>.hana.ondemand.com
CPI_TOKEN_URL_PRE_PROD=https://<preprod-subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
CPI_CLIENT_ID_PRE_PROD=<preprod-client-id>
CPI_CLIENT_SECRET_PRE_PROD=<preprod-client-secret>

# ── PROD environment ─────────────────────────────────────────────────────────
CPI_TENANT_URL_PROD=https://<prod-tenant>.it-cpi<n>.cfapps.<region>.hana.ondemand.com
CPI_TOKEN_URL_PROD=https://<prod-subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
CPI_CLIENT_ID_PROD=<prod-client-id>
CPI_CLIENT_SECRET_PROD=<prod-client-secret>

# ── Fallback / single-tenant ──────────────────────────────────────────────────
# Used for any env whose per-env vars above are absent.
CPI_TENANT_URL=https://<tenant>.it-cpi<instance>.cfapps.<region>.hana.ondemand.com
CPI_TOKEN_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
CPI_CLIENT_ID=<your-client-id>
CPI_CLIENT_SECRET=<your-client-secret>

# Spot-Check Agent Config
SPOT_CHECK_ENV=PROD          # TEST | PRE-PROD | PROD
SPOT_CHECK_IFLOW_ID=         # iFlow artifact ID to check (or pass via CLI)
SPOT_CHECK_BASELINE_DIR=./baselines          # folder holding baseline JSON snapshots
SPOT_CHECK_REPORT_PPTX_DIR=./reports/pptx   # folder for generated PPTX reports
SPOT_CHECK_REPORT_JSON_DIR=./reports/json   # folder for generated JSON reports

# Smoke test settings
SMOKE_TEST_ENABLED=true
SMOKE_TEST_PAYLOAD={"test":true,"source":"spot-check-agent","timestamp":"__NOW__"}
SMOKE_TEST_TIMEOUT_MS=10000

# Security checks
CERT_EXPIRY_WARN_DAYS=30     # flag certs expiring within N days

# Log level (debug | info | warn | error)
LOG_LEVEL=info
